# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings > API):

# Front-end (chave pública — aparece no bundle, pode ser exposta)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Somente Edge Functions (nunca coloque no front-end / no .env local do Vite)
# Definida em: Supabase > Edge Functions > Secrets (ou supabase secrets set)
# SUPABASE_SERVICE_ROLE_KEY=jwt-secret-do-service-role

# Reservada para a futura integração com o Refriclube (ainda sem uso).
# SEM prefixo VITE_: é segredo e nunca deve ir para o bundle do front-end
# (definida em Supabase > Edge Functions > Secrets).
# REFRICLUBE_SECRET_KEY=
